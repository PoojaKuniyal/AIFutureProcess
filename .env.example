# --- FREE / LOCAL DEFAULT STACK CONFIGURATION ---
# LLM Provider Configuration 
LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5:7b
LLM_BASE_URL=http://localhost:11434

# Optional LLM Provider Overrides (OpenAI / Anthropic / Groq / HuggingFace)
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4o-mini
# LLM_API_KEY=your_openai_api_key

# Research / Web Search Configuration (Free zero-key DuckDuckGo)
SEARCH_PROVIDER=duckduckgo
# SEARCH_PROVIDER=tavily
# TAVILY_API_KEY=your_tavily_api_key

# Local Embedding Configuration (Local SentenceTransformers)
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
EMBEDDING_DEVICE=cpu

# LangSmith Tracing Configuration (Optional - Free Tier)
LANGCHAIN_TRACING_V2=false  # set true for langsmith tracing
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT=ai-future-process-designer

# Database Connection (Docker Compose PostgreSQL)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=aifutureprocess
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Application Settings
APP_HOST=0.0.0.0
APP_PORT=8000
